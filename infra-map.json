        "IDENTIFICATION_NGINX_CONF": "./frontend/nginx.conf"
      },
      "labels": {
        "traefik.enable": "true",
        "traefik.http.routers.frontend.rule": "Host(`identification.localhost`)",
        "traefik.http.services.frontend.loadbalancer.server.port": "80"
